# Run npm run setup to save configuration in .env. Never commit real values.
# Existing .env.local files from managed tooling are migrated without changing their contents.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Managed branch metadata used by Neon environment tooling.
NEON_BRANCH=production
NEON_AUTH_BASE_URL=
# Managed Auth discovery value consumed by Neon tooling, even without a direct app reference.
NEON_AUTH_JWKS_URL=
# Generate a random 32-byte secret for the Next.js session cache.
NEON_AUTH_COOKIE_SECRET=
# Consumed implicitly by the Files SDK / AWS credential provider.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
# Shopee Open Platform app (server-only). Match the environment to your approved credentials.
# Intended production origin: https://ntbk.ajmission.dev; use production for live credentials.
SHOPEE_ENVIRONMENT=sandbox
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=https://ntbk.ajmission.dev/api/shopee/callback
# Random 32-byte base64 key; preserve it to decrypt stored shop tokens.
SHOPEE_TOKEN_ENCRYPTION_KEY=

# Lazada and TikTok Shop: server-only app credentials, never seller passwords.
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_REDIRECT_URI=https://ntbk.ajmission.dev/api/marketplaces/lazada/callback
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_SERVICE_ID=
TIKTOK_SHOP_REDIRECT_URI=https://ntbk.ajmission.dev/api/marketplaces/tiktok/callback
# Shared 32-byte base64 key for the new marketplace tokens. Preserve it.
MARKETPLACE_TOKEN_ENCRYPTION_KEY=

# Keep off until API scopes and real PH payloads are verified in a test shop.
LAZADA_ORDER_IMPORT_ENABLED=false
TIKTOK_SHOP_ORDER_IMPORT_ENABLED=false

# App-owned worker: keep disabled until a protected cron caller is deployed.
MARKETPLACE_SYNC_ENABLED=false
# A separate random secret of at least 32 characters; never expose to clients.
MARKETPLACE_SYNC_SECRET=

# Optional private database readiness check: separate random secret of at least 32 characters.
# Used only by GET /api/health/ready via Authorization: Bearer; never expose to browsers.
HEALTH_CHECK_SECRET=

# Self-service deletion: keep off until the complete disposable-account acceptance passes.
ACCOUNT_DELETION_ENABLED=false

# Dedicated project-scoped Neon management key for this server feature only.
NEON_ACCOUNT_DELETION_API_KEY=
NEON_ACCOUNT_DELETION_PROJECT_ID=
NEON_ACCOUNT_DELETION_BRANCH_ID=
